{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobius Device Lab",
  "version": "0.3.0",
  "identifier": "dev.mobius.device-lab",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mobius Device Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Android and iOS device operations workbench",
    "longDescription": "A cross-platform workbench for Android and iOS device operations, app development, testing and debugging.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/tools/**/*"],
    "linux": {
      "deb": {
        "recommends": ["usbmuxd"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
